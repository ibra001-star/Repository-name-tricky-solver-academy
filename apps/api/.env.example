# ── App ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────
# Matches docker-compose.yml postgres service
DATABASE_URL=postgresql://tsa_user:tsa_password@localhost:5432/tricky_solver_academy?schema=public

# ── JWT ────────────────────────────────────────────────────────────
# Generate strong secrets: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-this-with-a-random-64-character-secret-for-access-tokens
JWT_REFRESH_SECRET=replace-this-with-a-different-random-64-character-secret-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=30

# ── Google OAuth ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (SMTP) ───────────────────────────────────────────────────
# Leave blank in dev — emails will be logged to console instead of sent
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Tricky Solver Academy <no-reply@trickysolver.academy>"

# ── M-Pesa (Daraja API) ────────────────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-api-domain.com/api/v1/payments/mpesa/callback
MPESA_ENV=sandbox

# ── Stripe ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── PayPal ─────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# ── Cloudinary ─────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Africa's Talking (SMS) ─────────────────────────────────────────
# Leave blank in dev — SMS sends will be logged to console instead
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# ── Background jobs ────────────────────────────────────────────────
# Set to "true" to disable the in-process study-plan reminder scheduler
# (useful if running multiple API replicas and moving this to a dedicated
# worker, to avoid every replica running the same cron independently).
DISABLE_SCHEDULER=
